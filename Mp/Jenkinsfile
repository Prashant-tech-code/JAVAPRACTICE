pipeline {
    agent any

    tools {
        maven 'maven'
    }

    stages {

        stage('Checkout Code') {
            steps {
                git branch: 'Java_Practice', url: 'https://github.com/Prashant-tech-code/JAVAPRACTICE.git'
            }
        }

        stage('Compile Java Code') {
            steps {
                echo '🔧 Compiling all Java classes...'
                bat '''
                    cd Mp
                    mvn clean test-compile
                '''
            }
        }

        stage('Run Highest Number Program') {
            steps {
                echo '🚀 Running Highestno.java using Scanner input...'
                bat '''
                    cd Mp
                    echo 10>input.txt
                    echo 25>>input.txt
                    echo 30>>input.txt
                    mvn exec:java -Dexec.mainClass=myjava.Highestno -Dexec.classpathScope=test < input.txt
                '''
            }
        }

        stage('Run Prime Number Program') {
            steps {
                echo '🚀 Running Prime.java using Scanner input...'
                bat '''
                    cd Mp
                    echo 17>primeinput.txt
                    mvn exec:java -Dexec.mainClass=myjava.Prime -Dexec.classpathScope=test < primeinput.txt
                '''
            }
        }

        stage('Run Array Highest Program') {
            steps {
                echo '🚀 Running ArrayHighest.java using Scanner input...'
                bat '''
                    cd Mp
                    mvn exec:java -Dexec.mainClass=myjava.Highestfromarray -Dexec.classpathScope=test < arrayinput.txt
                '''
            }
        }
    }

    post {
        success {
            echo '✅ All three Java programs executed successfully!'
        }
        failure {
            echo '❌ Build failed — check which stage failed above.'
        }
    }
}
